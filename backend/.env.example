# ResumeForge AI Backend Environment Configuration

# OpenAI API Key (leave blank or provide your key; mock mode is used when unset)
OPENAI_API_KEY=

# OpenAI Model to use (e.g., gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional custom path to Tectonic or LaTeX compiler executable
TECTONIC_PATH=

